{
  "manifest_version": 3,
  "name": "QuickBuy",
  "version": "1.0.0",
  "description": "QuickBuy 1.0：票券與限量商品快速準備助手。平台辨識、數量/規格準備、提醒、備份與跨裝置加密接力；登入、驗證、排隊、付款與最後確認由使用者完成。",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "notifications",
    "power",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "開啟 QuickBuy 搶購助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "key": ""
}
